{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ejecutar agente",
            "type": "shell",
            "command": "py",
            "args": ["agente.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Ejecutar GUI",
            "type": "shell",
            "command": "py",
            "args": ["gui.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Instalar dependencias",
            "type": "shell",
            "command": "py",
            "args": ["-m", "pip", "install", "-r", "requirements.txt"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
